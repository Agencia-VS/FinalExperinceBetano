# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role: SOLO en servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Resend (envío de correos a ganadores) ----
RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en tu dominio (ej: concurso@tudominio.cl)
RESEND_FROM="Final Experience <concurso@tudominio.cl>"
# ⚠ OPCIONAL: Reply-to por defecto de los correos a ganadores (dónde llegan
# las respuestas, ej: el organizador). El admin puede sobreescribirlo por sesión.
# Si se deja vacío, el correo se envía sin header Reply-To.
RESEND_REPLY_TO="organizador@tudominio.cl"

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ⚠ OPCIONAL: Instante de cierre de la inscripción principal (ISO 8601, UTC).
# Por defecto 2026-07-15T14:00:00Z (15 jul 2026, 10:00 hora de Chile).
INSCRIPCION_CIERRA_AT=2026-07-15T14:00:00Z

# ---- API-Football (juego de pronósticos) ----
# Clave de https://www.api-football.com → Dashboard → API Keys
API_KEY_FOOTBALL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID del fixture de la Final (ej: el de la Final del Mundial 2026 en API-Football)
# ⚠ OPCIONAL: también puedes configurarlo desde /juego/admin sin tocar Vercel.
# Si se configura desde el admin, ese valor tiene prioridad sobre esta variable.
APIFOOTBALL_FIXTURE_ID=123456
# Secret para el endpoint del cron Vercel (cualquier string aleatorio)
CRON_SECRET=un-secret-aleatorio-largo
